{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamStudio",
  "version": "0.2.2",
  "identifier": "com.streamstudio.transmissor",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StreamStudio",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: http: wss: ws:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "streamstudio"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFNTQyODAwQjU4OTUzMkMKUldRc1U0bTFBQ2hVVHBFRFBvNWFabVRjY0RCUC90Z2M5cy8vQmRwUG5mOXJyTmNyeUo3RUNFaVkK",
      "endpoints": [
        "https://stream.exemplo.com/stream/baixar/atualizacao.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "useLocalToolsDir": true,
    "publisher": "StreamStudio",
    "shortDescription": "Transmita janelas e jogos para sua sala StreamStudio.",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  }
}
